---
title: Home
---
<h1>{{ site.title }}</h1>
<p>{{ site.description }}</p>
{% for post in search.pages("post", "date=desc", 10) %}
<section>
  <h2><a href="{{ post.url }}">{{ post.title }}</a></h2>
  <p><time datetime="{{ post.date | date('ISO') }}">{{ post.date | date }}</time></p>
  {{ (post.description or post.intro) | md }}
</section>
{% endfor %}
